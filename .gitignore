.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Spring Initializr
HELP.md

# IntelliJ IDEA (Einstellungen sind rechnerspezifisch)
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code
.vscode/

# Betriebssystem
.DS_Store
Thumbs.db
